{
  "name": "renew-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A focused Windows-first mGBA library and launcher",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm test",
    "package:win": "electron-builder --win portable --x64",
    "test:e2e": "playwright test",
    "test:desktop": "node --test tests/native/desktop-smoke.test.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1"
  },
  "build": {
    "appId": "app.renew.launcher",
    "productName": "Renew",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "src/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Renew-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Renew-${version}-win-${arch}.${ext}"
    }
  },
  "type": "module"
}
